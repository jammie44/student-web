# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite for dev:
DATABASE_URL=sqlite:///./studyhub.db
# PostgreSQL for production (Render gives you this):
# DATABASE_URL=postgresql://user:password@host:5432/studyhub

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ── Stripe (optional) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
